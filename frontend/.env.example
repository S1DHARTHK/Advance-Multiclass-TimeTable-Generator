# Copy to .env.local to point the UI at a real backend instead of the
# recorded Phase 1 GA output.
#
# When this is unset (the default) the app uses the mock data in
# src/data/mockTimetables.js. When it is set, src/api/timetableApi.js
# calls POST {VITE_API_BASE_URL}/api/timetable/generate instead. No UI
# changes are needed either way.

# VITE_API_BASE_URL=http://localhost:8000
